{
  "sections": {
    "main": {
      "type": "main-product",
      "blocks": {
        "style_loader": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "{{ 'velane-dawn-product.css' | asset_url | stylesheet_tag }}"
          }
        },
        "title": {"type": "title", "settings": {}},
        "price": {"type": "price", "settings": {}},
        "intro": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "<div class=\"velane-product-intro\">{% if product.metafields.custom.short_description != blank %}{{ product.metafields.custom.short_description | metafield_tag }}{% else %}<p>{{ product.description | strip_html | truncatewords: 32 }}</p>{% endif %}</div>"
          }
        },
        "variant_picker": {
          "type": "variant_picker",
          "settings": {"picker_type": "button", "swatch_shape": "circle"}
        },
        "offers": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "<div class=\"velane-offers-block\"><p class=\"velane-offers-heading\">Available Offers :</p><div class=\"velane-offers-grid\"><div class=\"velane-offer-card\"><span class=\"velane-offer-radio\"></span><div><p class=\"velane-offer-title\">Get 10% OFF</p><p class=\"velane-offer-sub\">Minimum ₹4,000 order</p></div><div class=\"velane-offer-value\">₹4,500<s>₹5,000</s></div><span class=\"velane-offer-code\">SAVE10</span></div><div class=\"velane-offer-card\"><span class=\"velane-offer-radio\"></span><div><p class=\"velane-offer-title\">Get 10% OFF</p><p class=\"velane-offer-sub\">Minimum ₹6,000 order</p></div><div class=\"velane-offer-value\">₹8,000<s>₹10,000</s></div><span class=\"velane-offer-code\">SAVE20</span></div></div></div>"
          }
        },
        "quantity_selector": {"type": "quantity_selector", "settings": {}},
        "buy_buttons": {
          "type": "buy_buttons",
          "settings": {"show_dynamic_checkout": true, "show_gift_card_recipient": true}
        },
        "description": {"type": "description", "settings": {}},
        "care": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Care",
            "icon": "none",
            "content": "<p>Keep your jewellery away from perfume, moisture and harsh chemicals. Store dry and wipe gently with a soft cloth after wear.</p>"
          }
        },
        "delivery": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Delivery & Return",
            "icon": "none",
            "content": "<p>Orders are carefully packed and dispatched as per the delivery promise shown at checkout. Returns are accepted as per store policy.</p>"
          }
        },
        "further": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Further Information",
            "icon": "none",
            "content": "<p>Colour, finish and scale can vary slightly between photography and the final handcrafted piece.</p>"
          }
        }
      },
      "block_order": ["style_loader", "title", "price", "intro", "variant_picker", "offers", "quantity_selector", "buy_buttons", "description", "care", "delivery", "further"],
      "settings": {
        "enable_sticky_info": true,
        "color_scheme": "scheme-1",
        "media_size": "medium",
        "constrain_to_viewport": false,
        "media_fit": "cover",
        "gallery_layout": "columns",
        "mobile_thumbnails": "show",
        "media_position": "left",
        "image_zoom": "lightbox",
        "hide_variants": true,
        "enable_video_looping": false,
        "padding_top": 48,
        "padding_bottom": 56
      }
    },
    "benefits": {
      "type": "velane-product-benefits",
      "blocks": {
        "shipping": {"type": "benefit", "settings": {"icon": "shipping", "heading": "Free Shipping", "text": "On orders over ₹499"}},
        "warranty": {"type": "benefit", "settings": {"icon": "warranty", "heading": "6-Month Warranty", "text": "On every piece"}},
        "returns": {"type": "benefit", "settings": {"icon": "returns", "heading": "Easy 15-Day Returns", "text": "No questions asked"}},
        "cod": {"type": "benefit", "settings": {"icon": "cod", "heading": "COD Available", "text": "Pay when delivered"}}
      },
      "block_order": ["shipping", "warranty", "returns", "cod"],
      "settings": {"color_scheme": "scheme-1"}
    },
    "details": {
      "type": "velane-product-details",
      "blocks": {
        "material": {"type": "spec", "settings": {"label": "Material", "source": "material", "fallback": "925 Silver · 18K Gold dip"}},
        "finish": {"type": "spec", "settings": {"label": "Finish", "source": "finish", "fallback": "High-polish, anti-tarnish"}},
        "weight": {"type": "spec", "settings": {"label": "Weight", "source": "weight", "fallback": "3.2 g"}},
        "width": {"type": "spec", "settings": {"label": "Band width", "source": "band_width", "fallback": "2.4 mm"}}
      },
      "block_order": ["material", "finish", "weight", "width"],
      "settings": {
        "eyebrow": "THE DETAILS",
        "heading": "Crafted to be worn, loved, and kept.",
        "use_product_description": true,
        "text": "<p>Every Velane piece is finished by hand and designed for everyday wear.</p>",
        "color_scheme": "scheme-2"
      }
    },
    "related": {
      "type": "velane-related-products",
      "settings": {
        "eyebrow": "STYLE FOR YOU",
        "heading": "You May Also Like",
        "products_to_show": 4,
        "show_view_all": true
      }
    }
  },
  "order": ["main", "benefits", "details", "related"]
}
