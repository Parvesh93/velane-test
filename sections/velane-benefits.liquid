<section class="vl-benefits vl-section" aria-label="Shopping benefits"><div class="vl-wrap vl-benefits-grid">{% for block in section.blocks %}<div class="vl-benefit" {{ block.shopify_attributes }}><span class="vl-icon">{% assign icon = 'icon-' | append: block.settings.icon | append: '.svg' %}{{ icon | inline_asset_content }}</span><div><p>{{ block.settings.heading | escape }}</p><small>{{ block.settings.text | escape }}</small></div></div>{% endfor %}</div></section>
{% schema %}
{
  "name": "Velane benefits",
  "settings": [],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            {
              "value": "truck",
              "label": "Delivery"
            },
            {
              "value": "check-mark",
              "label": "Quality"
            },
            {
              "value": "return",
              "label": "Returns"
            },
            {
              "value": "price-tag",
              "label": "Payment"
            }
          ],
          "default": "truck"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Free Shipping"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Detail",
          "default": "On orders over \u20b92,000"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Velane benefits"
    }
  ]
}
{% endschema %}
