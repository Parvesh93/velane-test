<section class="vl-section vl-craft" id="velane-craft" aria-labelledby="VlCraft-{{ section.id }}"><div class="vl-wrap vl-craft-grid">{% render 'velane-image', image: section.settings.image, reference: 'craft', alt: section.settings.image_alt, sizes: '(min-width: 750px) 50vw, 100vw' %}<div class="vl-craft-copy"><p class="vl-eyebrow">{{ section.settings.eyebrow | escape }}</p><h2 id="VlCraft-{{ section.id }}">{{ section.settings.heading | escape | newline_to_br }}</h2><div>{{ section.settings.text }}</div><div class="vl-stat-grid">{% for block in section.blocks %}<div class="vl-stat" {{ block.shopify_attributes }}><strong>{{ block.settings.value | escape }}</strong><span>{{ block.settings.label | escape }}</span></div>{% endfor %}</div>{% if section.settings.link != blank %}<a class="vl-text-link" href="{{ section.settings.link }}">{{ section.settings.button | escape }} <span aria-hidden="true">→</span></a>{% endif %}</div></div></section>
{% schema %}
{
  "name": "Velane craftsmanship",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "OUR CRAFT"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "Anti-tarnish.\nHand-finished."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Description",
      "default": "<p>Every piece is made from 925 sterling silver with a triple layer of 18k gold, engineered to stay bright through daily wear, water, and workouts.</p>"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Image description",
      "default": "Artisan hand-finishing jewellery at a workbench"
    },
    {
      "type": "text",
      "id": "button",
      "label": "Link label",
      "default": "Learn about our craft"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    }
  ],
  "max_blocks": 4,
  "blocks": [
    {
      "type": "stat",
      "name": "Material detail",
      "settings": [
        {
          "type": "text",
          "id": "value",
          "label": "Value",
          "default": "925"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Sterling Silver"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Velane craftsmanship"
    }
  ]
}
{% endschema %}
