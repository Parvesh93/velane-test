{% liquid
  assign review_count = 0
  for block in section.blocks
    if block.settings.quote != blank
      assign review_count = review_count | plus: 1
    endif
  endfor
%}
{% if review_count > 0 or request.design_mode %}
<section class="vl-section vl-wrap vl-testimonials" aria-labelledby="VlTestimonials-{{ section.id }}"><div class="vl-section-heading vl-center"><h2 id="VlTestimonials-{{ section.id }}">{{ section.settings.heading | escape }}</h2><p>{{ section.settings.text | escape }}</p></div><div class="vl-review-grid">{% for block in section.blocks %}{% if block.settings.quote != blank %}<figure class="vl-review" {{ block.shopify_attributes }}><p class="vl-stars" aria-label="{{ block.settings.rating }} out of 5 stars">{% for star in (1..block.settings.rating) %}★{% endfor %}</p><blockquote>{{ block.settings.quote | escape }}</blockquote><figcaption>{{ block.settings.author | escape }}</figcaption></figure>{% elsif request.design_mode %}<div class="vl-review vl-editor-note" {{ block.shopify_attributes }}>Add your approved customer review and name in this block.</div>{% endif %}{% endfor %}</div></section>
{% endif %}
{% schema %}
{
  "name": "Velane testimonials",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Testimonials"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Subheading",
      "default": "Real words from real customers."
    }
  ],
  "max_blocks": 6,
  "blocks": [
    {
      "type": "review",
      "name": "Customer review",
      "settings": [
        {
          "type": "textarea",
          "id": "quote",
          "label": "Review"
        },
        {
          "type": "text",
          "id": "author",
          "label": "Customer name"
        },
        {
          "type": "range",
          "id": "rating",
          "label": "Rating",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 5
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Velane testimonials"
    }
  ]
}
{% endschema %}
