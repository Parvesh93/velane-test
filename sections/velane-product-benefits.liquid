<section class="velane-product-benefits color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width velane-benefits-grid">
    {% for block in section.blocks %}
      <div class="velane-benefit-item" {{ block.shopify_attributes }}>
        <span class="velane-benefit-icon" aria-hidden="true">
          {% case block.settings.icon %}
            {% when 'shipping' %}
              <svg viewBox="0 0 24 24" fill="none"><path d="M3 7h11v9H3V7Zm11 3h4l3 3v3h-7v-6ZM6 19a2 2 0 1 0 0-4 2 2 0 0 0 0 4Zm12 0a2 2 0 1 0 0-4 2 2 0 0 0 0 4Z"/></svg>
            {% when 'warranty' %}
              <svg viewBox="0 0 24 24" fill="none"><path d="m12 3 6 2v6c0 4-2.5 7-6 9-3.5-2-6-5-6-9V5l6-2Z"/><path d="m9 11 2 2 4-4"/></svg>
            {% when 'returns' %}
              <svg viewBox="0 0 24 24" fill="none"><path d="M4 12a8 8 0 1 0 2.3-5.7L4 8"/><path d="M4 4v4h4"/></svg>
            {% when 'cod' %}
              <svg viewBox="0 0 24 24" fill="none"><rect x="3" y="6" width="18" height="12" rx="2"/><path d="M8 12h8"/></svg>
            {% else %}
              <svg viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="9"/><path d="m8.5 12 2.2 2.2 4.8-5"/></svg>
          {% endcase %}
        </span>
        <div>
          <strong>{{ block.settings.heading | escape }}</strong>
          {% if block.settings.text != blank %}<small>{{ block.settings.text | escape }}</small>{% endif %}
        </div>
      </div>
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "Velane product benefits",
  "enabled_on": {"templates": ["product"]},
  "settings": [
    {"type":"color_scheme","id":"color_scheme","label":"Color scheme","default":"scheme-1"}
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "limit": 4,
      "settings": [
        {"type":"select","id":"icon","label":"Icon","default":"shipping","options":[{"value":"shipping","label":"Shipping"},{"value":"warranty","label":"Warranty"},{"value":"returns","label":"Returns"},{"value":"cod","label":"COD"},{"value":"check","label":"Check"}]},
        {"type":"text","id":"heading","label":"Heading","default":"Free Shipping"},
        {"type":"text","id":"text","label":"Text","default":"On orders over ₹499"}
      ]
    }
  ],
  "presets": [{
    "name":"Velane product benefits",
    "blocks":[{"type":"benefit"},{"type":"benefit"},{"type":"benefit"},{"type":"benefit"}]
  }]
}
{% endschema %}
