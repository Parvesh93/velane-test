<div class="vl-header">
  <div class="vl-announcements" aria-label="Store announcements">
    {% for block in section.blocks %}<span {{ block.shopify_attributes }}>{{ block.settings.text | escape }}</span>{% endfor %}
  </div>
  <header class="vl-wrap">
    <div class="vl-header-top">
      <details class="vl-mobile-menu" data-vl-disclosure>
        <summary aria-label="Open menu"><span class="vl-icon">{{ 'icon-hamburger.svg' | inline_asset_content }}</span></summary>
        <nav aria-label="Mobile navigation">{% render 'velane-navigation', menu: section.settings.menu %}</nav>
      </details>
      <details class="vl-search" data-vl-disclosure>
        <summary aria-label="Search"><span class="vl-icon">{{ 'icon-search.svg' | inline_asset_content }}</span></summary>
        <form action="{{ routes.search_url }}" method="get" role="search">
          <label class="visually-hidden" for="VlSearch-{{ section.id }}">Search products</label>
          <input id="VlSearch-{{ section.id }}" type="search" name="q" placeholder="Search jewellery" required>
          <input type="hidden" name="type" value="product">
          <button class="vl-button" type="submit">Search</button>
        </form>
      </details>
      <a class="vl-wordmark" href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }} home">
        {% if settings.logo != blank %}{{ settings.logo | image_url: width: 440 | image_tag: width: settings.logo_width, alt: shop.name }}{% else %}{{ section.settings.wordmark | escape }}{% endif %}
      </a>
      <div class="vl-header-actions">
        {% if shop.customer_accounts_enabled %}<a class="vl-account" href="{{ routes.account_url }}" aria-label="Account"><span class="vl-icon">{{ 'icon-account.svg' | inline_asset_content }}</span></a>{% endif %}
        <a href="{{ routes.cart_url }}" aria-label="{{ 'templates.cart.cart' | t }}" id="cart-icon-bubble"><span class="vl-icon">{{ 'icon-cart-empty.svg' | inline_asset_content }}</span>{% if cart.item_count > 0 %}<span class="cart-count-bubble">{{ cart.item_count }}</span>{% endif %}</a>
      </div>
    </div>
    <nav class="vl-desktop-nav" aria-label="Main navigation">{% render 'velane-navigation', menu: section.settings.menu %}</nav>
  </header>
</div>
{% schema %}
{
  "name": "Velane header",
  "settings": [
    {
      "type": "text",
      "id": "wordmark",
      "label": "Wordmark",
      "default": "VELANE"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "default": "main-menu"
    }
  ],
  "enabled_on": {
    "groups": [
      "header"
    ]
  },
  "blocks": [
    {
      "type": "announcement",
      "name": "Announcement",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Free shipping over Rs 2,000"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Velane header"
    }
  ]
}
{% endschema %}
