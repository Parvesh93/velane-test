<section class="vl-hero vl-section" aria-labelledby="VlHero-{{ section.id }}">
  <div class="vl-wrap vl-hero-grid">
    <div class="vl-hero-copy">
      <p class="vl-eyebrow vl-sale-label">{{ section.settings.eyebrow | escape }}</p>
      <h1 id="VlHero-{{ section.id }}">{{ section.settings.heading | escape | newline_to_br }}</h1>
      <div class="vl-hero-description">{{ section.settings.description }}</div>
      <a class="vl-button" href="{{ section.settings.link | default: routes.all_products_collection_url }}">{{ section.settings.button | escape }} <span aria-hidden="true">→</span></a>
      <p class="vl-hero-notes">{{ section.settings.notes | escape }}</p>
    </div>
    <div class="vl-hero-media">
      <div class="{% if section.settings.mobile_image != blank %}vl-desktop-image{% endif %}">{% render 'velane-image', image: section.settings.image, reference: 'hero', alt: section.settings.image_alt, eager: true, sizes: '(min-width: 750px) 50vw, 100vw' %}</div>
      {% if section.settings.mobile_image != blank %}<div class="vl-mobile-image">{% render 'velane-image', image: section.settings.mobile_image, reference: 'hero', alt: section.settings.image_alt, eager: true, sizes: '100vw' %}</div>{% endif %}
      {% if section.settings.featured_product != blank %}{% assign featured = section.settings.featured_product %}<a class="vl-hero-product" href="{{ featured.url }}"><span class="vl-eyebrow">In the spotlight</span><span>{{ featured.title | escape }}</span><span>{{ featured.price | money }}</span></a>{% elsif section.settings.spotlight_title != blank %}<a class="vl-hero-product" href="{{ section.settings.link | default: routes.all_products_collection_url }}"><span class="vl-eyebrow">In the spotlight</span><span>{{ section.settings.spotlight_title | escape }}</span></a>{% endif %}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Velane sale hero",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "END OF SEASON SALE \u00b7 LIVE NOW"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "Flat 50% Off on\neverything gold."
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Certified 925 silver with 18k gold plating. Anti-tarnish, hypoallergenic, and made to be worn every single day.</p>"
    },
    {
      "type": "text",
      "id": "button",
      "label": "Button label",
      "default": "SHOP THE SALE"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Button link"
    },
    {
      "type": "text",
      "id": "notes",
      "label": "Trust line",
      "default": "\u2713 925 Sterling Silver   \u00b7   \u2713 18k Gold Plated   \u00b7   \u2713 6 Month Warranty"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Desktop image"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile image"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Image description",
      "default": "Gold statement necklace styled with a tailored cream blazer"
    },
    {
      "type": "product",
      "id": "featured_product",
      "label": "Featured product"
    },
    {
      "type": "text",
      "id": "spotlight_title",
      "label": "Spotlight title before choosing a product",
      "default": "The Statement Necklace"
    }
  ],
  "presets": [
    {
      "name": "Velane sale hero"
    }
  ]
}
{% endschema %}
