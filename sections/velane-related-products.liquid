{{ 'component-price.css' | asset_url | stylesheet_tag }}

{%- style -%}
  #shopify-section-{{ section.id }} .vl-related-recommendations {
    display: block;
    width: 100%;
  }
{%- endstyle -%}

<section
  class="vl-section vl-products vl-wrap vl-related-products"
  aria-labelledby="VlRelated-{{ section.id }}"
>
  <product-recommendations
    class="vl-related-recommendations"
    data-url="{{ routes.product_recommendations_url }}?limit={{ section.settings.products_to_show }}"
    data-section-id="{{ section.id }}"
    data-product-id="{{ product.id }}"
  >
    {% if recommendations.performed and recommendations.products_count > 0 %}
      <div class="vl-section-heading vl-products-heading">
        <div>
          <p class="vl-eyebrow">{{ section.settings.eyebrow | escape }}</p>
          <h2 id="VlRelated-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
        </div>
        {% if section.settings.show_view_all %}
          <a class="vl-view-all" href="{{ routes.all_products_collection_url }}">
            View all <span aria-hidden="true">↗</span>
          </a>
        {% endif %}
      </div>

      <div class="vl-product-grid">
        {% for recommendation in recommendations.products %}
          {% render 'velane-product-card',
            product: recommendation,
            section_id: section.id,
            group_id: 'related'
          %}
        {% endfor %}
      </div>
    {% endif %}
  </product-recommendations>
</section>

{% schema %}
{
  "name": "Velane recommendations",
  "enabled_on": {"templates": ["product"]},
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "STYLE FOR YOU"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "You May Also Like"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 4
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show view all",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Velane recommendations"
    }
  ]
}
{% endschema %}
