<section class="vl-section vl-categories vl-wrap" aria-labelledby="VlCategories-{{ section.id }}"><div class="vl-section-heading vl-center"><h2 id="VlCategories-{{ section.id }}">{{ section.settings.heading | escape }}</h2><p>{{ section.settings.text | escape }}</p></div><div class="vl-category-grid">{% for block in section.blocks %}{% assign category_image = block.settings.image | default: block.settings.collection.featured_image %}<a class="vl-category" href="{{ block.settings.collection.url | default: routes.collections_url }}" {{ block.shopify_attributes }}>{% render 'velane-image', image: category_image, reference: block.settings.reference, alt: block.settings.title, sizes: '(min-width: 750px) 14vw, 30vw' %}<span>{{ block.settings.title | escape }}</span></a>{% endfor %}</div></section>
{% schema %}
{
  "name": "Velane categories",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop By Category"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Subheading",
      "default": "Handpicked collections. Timeless beauty."
    }
  ],
  "max_blocks": 8,
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Rings"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "select",
          "id": "reference",
          "label": "Placeholder layout",
          "options": [
            {
              "value": "rings",
              "label": "Rings"
            },
            {
              "value": "earrings",
              "label": "Earrings"
            },
            {
              "value": "necklaces",
              "label": "Necklaces"
            },
            {
              "value": "bracelets",
              "label": "Bracelets"
            },
            {
              "value": "bangles",
              "label": "Bangles"
            },
            {
              "value": "pendants",
              "label": "Pendants"
            },
            {
              "value": "anklets",
              "label": "Anklets"
            }
          ],
          "default": "rings"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Velane categories"
    }
  ]
}
{% endschema %}
