<section class="velane-product-details color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width velane-details-grid">
    <div class="velane-details-copy">
      {% if section.settings.eyebrow != blank %}<p class="velane-details-eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}
      <h2>{{ section.settings.heading | escape }}</h2>
      <div class="rte">
        {% if section.settings.use_product_description and product.description != blank %}
          {{ product.description }}
        {% else %}
          {{ section.settings.text }}
        {% endif %}
      </div>
    </div>
    <div class="velane-spec-grid">
      {% for block in section.blocks %}
        <div class="velane-spec-card" {{ block.shopify_attributes }}>
          <span>{{ block.settings.label | escape }}</span>
          <strong>
            {% case block.settings.source %}
              {% when 'material' %}{% if product.metafields.custom.material != blank %}{{ product.metafields.custom.material | metafield_text }}{% else %}{{ block.settings.fallback | escape }}{% endif %}
              {% when 'finish' %}{% if product.metafields.custom.finish != blank %}{{ product.metafields.custom.finish | metafield_text }}{% else %}{{ block.settings.fallback | escape }}{% endif %}
              {% when 'weight' %}{% if product.metafields.custom.weight != blank %}{{ product.metafields.custom.weight | metafield_text }}{% else %}{{ block.settings.fallback | escape }}{% endif %}
              {% when 'band_width' %}{% if product.metafields.custom.band_width != blank %}{{ product.metafields.custom.band_width | metafield_text }}{% else %}{{ block.settings.fallback | escape }}{% endif %}
              {% else %}{{ block.settings.fallback | escape }}
            {% endcase %}
          </strong>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name":"Velane product details",
  "enabled_on":{"templates":["product"]},
  "settings":[
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"THE DETAILS"},
    {"type":"text","id":"heading","label":"Heading","default":"Crafted to be worn, loved, and kept."},
    {"type":"checkbox","id":"use_product_description","label":"Use product description","default":true},
    {"type":"richtext","id":"text","label":"Fallback text","default":"<p>Every Velane piece is finished by hand and designed for everyday wear.</p>"},
    {"type":"color_scheme","id":"color_scheme","label":"Color scheme","default":"scheme-2"}
  ],
  "blocks":[
    {
      "type":"spec",
      "name":"Specification",
      "limit":4,
      "settings":[
        {"type":"text","id":"label","label":"Label","default":"Material"},
        {"type":"select","id":"source","label":"Metafield source","default":"material","options":[{"value":"material","label":"Material"},{"value":"finish","label":"Finish"},{"value":"weight","label":"Weight"},{"value":"band_width","label":"Band width"},{"value":"none","label":"None / fallback only"}]},
        {"type":"text","id":"fallback","label":"Fallback value","default":"925 Silver · 18K Gold dip"}
      ]
    }
  ],
  "presets":[{
    "name":"Velane product details",
    "blocks":[{"type":"spec","settings":{"label":"Material","source":"material","fallback":"925 Silver · 18K Gold dip"}},{"type":"spec","settings":{"label":"Finish","source":"finish","fallback":"High-polish, anti-tarnish"}},{"type":"spec","settings":{"label":"Weight","source":"weight","fallback":"3.2 g"}},{"type":"spec","settings":{"label":"Band width","source":"band_width","fallback":"2.4 mm"}}]
  }]
}
{% endschema %}
