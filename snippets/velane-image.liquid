{% comment %}
  Image picker selections are served through Shopify's responsive image CDN.
  No user-provided reference attachments are included in the public repository.
{% endcomment %}
{% liquid
  assign ratio = '1'
  case reference
    when 'hero'
      assign ratio = '278 / 175'
    when 'craft'
      assign ratio = '261 / 180'
    when 'men', 'women'
      assign ratio = '112 / 99'
    when 'product-1', 'product-2', 'product-3', 'product-4', 'product-5', 'product-6', 'product-7', 'product-8'
      assign ratio = '123 / 139'
  endcase
  assign loading = 'lazy'
  if eager
    assign loading = 'eager'
  endif
%}
<span class="vl-image {{ class }}" style="--vl-image-ratio: {{ ratio }};">
  {% if image != blank %}
    {{ image | image_url: width: 1600 | image_tag: widths: '180, 360, 540, 750, 1100, 1600', sizes: sizes, loading: loading, alt: alt }}
  {% else %}
    {{ 'product-1' | placeholder_svg_tag: 'vl-placeholder placeholder-svg' }}
  {% endif %}
</span>
